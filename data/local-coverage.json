{
  "network": [
    {
      "regexFilter": "^https?://[^/?#]+/(?:[^?#]*/)?widget/ads\\.(?:min\\.)?js(?:[?#]|$)",
      "resourceTypes": [
        "script",
        "xmlhttprequest"
      ]
    },
    {
      "regexFilter": "^https?://[^/?#]+/(?:[^?#]*/)?pagead\\.js(?:[?#]|$)",
      "resourceTypes": [
        "script",
        "xmlhttprequest"
      ]
    },
    {
      "regexFilter": "^https?://[^/?#]+/(?:[^?#]*/)?ads/ads\\.js(?:[?#]|$)",
      "resourceTypes": [
        "script",
        "xmlhttprequest"
      ]
    },
    {
      "requestDomains": [
        "onead.com.tw",
        "onead.onevision.com.tw",
        "clickforce.com.tw",
        "popin.cc",
        "ad.toutiao.com",
        "tongji.baidu.com"
      ],
      "domainType": "thirdParty",
      "excludedResourceTypes": [
        "main_frame"
      ]
    }
  ],
  "cosmetic": [
    {
      "hosts": [],
      "selectors": [
        ".textads",
        ".adsbox",
        ".banner_ads",
        "amp-embed[type=\"adsense\"]",
        "amp-embed[type=\"doubleclick\"]",
        "amp-embed[type=\"a9\"]",
        "amp-sticky-ad:has(amp-ad, amp-embed[type=\"adsense\"], amp-embed[type=\"doubleclick\"], amp-embed[type=\"a9\"])"
      ]
    },
    {
      "hosts": [
        "www.sina.com.cn"
      ],
      "selectors": [
        "div[id^=\"ad_\"]"
      ]
    }
  ]
}
